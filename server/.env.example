# --- LLM ---
GEMINI_API_KEY=your-key-from-aistudio.google.com
PRIMARY_MODEL=gemini-2.5-flash-lite
ESCALATION_MODEL=gemini-2.5-flash
CONFIDENCE_THRESHOLD=0.8

# --- Pipeline ---
# How long to buffer a group's messages before one extraction call (ms)
FLUSH_INTERVAL_MS=600000
# Flush early if a group accumulates this many messages
MAX_BATCH_SIZE=25

# --- Storage ---
DB_PATH=./classmate.db

# --- Planner API ---
API_PORT=4000

# --- Ingestion source: baileys | fake ---
SOURCE=baileys
# Directory where the Baileys session credentials are stored (crown jewels - never commit)
BAILEYS_AUTH_DIR=./baileys-auth

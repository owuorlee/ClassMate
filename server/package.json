{
  "name": "classmate-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ClassMate ingestion + AI extraction service: turns WhatsApp class-group messages into structured planner events.",
  "scripts": {
    "dev": "tsx src/index.ts",
    "replay": "tsx src/index.ts --replay",
    "api": "tsx src/apiServer.ts",
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.9.0",
    "@whiskeysockets/baileys": "^6.7.18",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "qrcode-terminal": "^0.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
